---
layout: base.njk
---
<article class="post">
  {% if series %}
  <p class="post-eyebrow"><a href="/">{{ series }}</a> &middot; Part {{ part }}</p>
  {% else %}
  <p class="post-eyebrow"><a href="/">&larr; All posts</a></p>
  {% endif %}
  <h1>{{ title }}</h1>
  <p class="post-meta">{{ date | date }}</p>
  <div class="post-body">
    {{ content | safe }}
  </div>

  {% if series %}
  {% set prev = collections.seriesList | seriesNeighbor(series, part, "prev") %}
  {% set next = collections.seriesList | seriesNeighbor(series, part, "next") %}
  {% if prev or next %}
  <nav class="series-nav">
    {% if prev %}<a class="series-nav-prev" href="{{ prev.url }}">&larr; Part {{ prev.data.part }}: {{ prev.data.title }}</a>{% endif %}
    {% if next %}<a class="series-nav-next" href="{{ next.url }}">Part {{ next.data.part }}: {{ next.data.title }} &rarr;</a>{% endif %}
  </nav>
  {% endif %}
  {% endif %}
</article>
